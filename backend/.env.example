APP_NAME=My-Finance-Tracker
ENVIRONMENT=development
DEBUG=true

# SQLite for local dev. Swap to a PostgreSQL URL later, e.g.:
# postgresql+psycopg2://user:password@localhost:5432/finance_tracker
DATABASE_URL=sqlite:///./finance_tracker.db

# Generate a real secret for anything beyond local dev, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
